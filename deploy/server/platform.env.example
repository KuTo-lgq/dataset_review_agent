# Runtime configuration for dataset review platform.
# Copy to .env on the server and fill in values that apply to your environment.

DATASET_AUDIT_API_KEY=
DATASET_REVIEW_MODEL_ENDPOINT=http://127.0.0.1:8080/api/chat/completions
DATASET_REVIEW_REMOTE_MODEL_ENDPOINT=http://127.0.0.1:8080/api/chat/completions
DATASET_REVIEW_MODEL_NAME=multimodal-review-model
DATASET_REVIEW_API_KEY_ENV=DATASET_AUDIT_API_KEY

# If the platform runs on the same server as the data, Linux absolute paths will be treated as local.
# Only set SSH fields if you want the platform to dispatch to a different remote host.
DATASET_REVIEW_SSH_USER=reviewer
DATASET_REVIEW_SSH_HOST=10.0.0.10
DATASET_REVIEW_SSH_PORT=22
# DATASET_REVIEW_SSH_ASKPASS=/home/reviewer/dataset-review-agent/askpass.cmd

DATASET_REVIEW_REMOTE_PIPELINE_DIR=/home/reviewer/dataset-review-agent/dataset_audit_pipeline
DATASET_REVIEW_REMOTE_CONFIG_DIR=/home/reviewer/dataset-review-agent/runtime/platform_generated_configs
DATASET_REVIEW_REMOTE_RUNS_DIR=/home/reviewer/dataset-review-agent/runtime/platform_runs
DATASET_REVIEW_DB_PATH=/home/reviewer/dataset-review-agent/runtime/review_platform.db
DATASET_REVIEW_REMOTE_STATUS_TIMEOUT_SECONDS=1.5
PYTHONIOENCODING=utf-8
